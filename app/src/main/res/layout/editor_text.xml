<?xml version="1.0" encoding="utf-8"?>
<!-- The editor (E9) in the page that scrolls it: the editor grows with its text, so its padding
     (the page insets and the anchor's space, E11) is never clipped as a scrolling EditText clips it.
     allowUndo="false": undo and redo are the core's, never the platform's (E12). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <com.fiftyhoursaweek.slowpage.editor.EditorText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:allowUndo="false" />
</ScrollView>
