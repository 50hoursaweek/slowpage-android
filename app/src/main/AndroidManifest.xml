<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phones and tablets (Francesco, 2026-11-02); not checked below 360 dp. -->
    <supports-screens android:smallScreens="false" android:normalScreens="true"
        android:largeScreens="true" android:xlargeScreens="true" />

    <!-- allowBackup=false: S5, approved.
         largeHeap: a document may be 20 MiB (E13). The editor holds it as UTF-16 (40 MB), and
         a save copies it out of the core and back in (saveSucceeded takes the text), so the
         standard heap (192 MB on the API 31 emulator) ran out at 19 MiB (round 1, F3). -->
    <application
        android:name=".SlowpageApp"
        android:label="Slowpage"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- One window (L3): singleTask, one document at a time. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
